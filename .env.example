# AIPI - Universal AI Protocol Interface & Model Gateway
# Configuration Environment Variables Template

# Gateway Server Port (Default: 11434)
AIPI_PORT=11434
AIPI_HOST=0.0.0.0

# Master Vault Encryption Key (auto-generated if empty)
# AIMM_VAULT_KEY=your-32-byte-hex-encryption-key

# Admin & License Secret (Set a strong secret in production)
AIMM_LICENSE_SECRET=aipi-production-secret-replace-with-strong-key

# Google Antigravity OAuth Client Credentials (Optional override)
# ANTIGRAVITY_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=your-client-secret

# GitHub Copilot OAuth Client ID (Optional override)
# GITHUB_COPILOT_CLIENT_ID=your-github-client-id

# Privacy & Air-Gapped Stealth Mode
# AIPI_STEALTH_MODE=false
# AIPI_PII_MASKING=true
